     use super::*;
 
+    #[test]
+    fn test_creation_admission_limit_reduction_is_drain_only() {
+        let admission = Arc::new(CreatingStreamingJobPermit::with_limit(2));
+        let first = admission.try_acquire_job(JobId::new(1)).unwrap();
+        let second = admission.try_acquire_job(JobId::new(2)).unwrap();
+        admission.set_limit(1);
+        assert!(admission.try_acquire_job(JobId::new(3)).is_none());
+        drop(first);
+        assert!(admission.try_acquire_job(JobId::new(3)).is_none());
+        drop(second);
+        let third = admission.try_acquire_job(JobId::new(3)).unwrap();
+        assert_eq!(admission.stats().active, 1);
+        drop(third);
+        assert_eq!(admission.stats().active, 0);
+    }
+
+    #[test]
+    fn test_creation_admission_recovery_can_start_over_limit() {
+        let admission = Arc::new(CreatingStreamingJobPermit::with_limit(1));
+        let first = admission.claim_recovered(JobId::new(10));
+        let second = admission.claim_recovered(JobId::new(11));
+        assert_eq!(admission.stats().active, 2);
+        assert_eq!(admission.stats().tracked_jobs, 2);
+        assert!(admission.try_acquire_job(JobId::new(12)).is_none());
+        drop(first);
+        assert!(admission.try_acquire_job(JobId::new(12)).is_none());
+        drop(second);
+        assert!(admission.try_acquire_job(JobId::new(12)).is_some());
+    }
+
+    #[tokio::test]
+    async fn test_creation_admission_reports_waiters_and_wakes_on_release() {
+        let admission = Arc::new(CreatingStreamingJobPermit::with_limit(1));
+        let first = admission.acquire_job(JobId::new(20)).await;
+        let waiting_admission = admission.clone();
+        let waiter =
+            tokio::spawn(async move { waiting_admission.acquire_job(JobId::new(21)).await });
+        tokio::time::timeout(Duration::from_secs(1), async {
+            while admission.stats().waiting != 1 {
+                tokio::task::yield_now().await;
+            }
+        })
+        .await
+        .unwrap();
+        assert_eq!(admission.stats().active, 1);
+        drop(first);
+        let second = waiter.await.unwrap();
+        assert_eq!(admission.stats().waiting, 0);
+        assert_eq!(admission.stats().active, 1);
+        drop(second);
+    }
+
+    #[tokio::test]
+    async fn test_creation_admission_limit_increase_wakes_waiter() {
+        let admission = Arc::new(CreatingStreamingJobPermit::with_limit(1));
+        let first = admission.acquire_job(JobId::new(30)).await;
+        let waiting_admission = admission.clone();
+        let waiter =
+            tokio::spawn(async move { waiting_admission.acquire_job(JobId::new(31)).await });
+        tokio::time::timeout(Duration::from_secs(1), async {
+            while admission.stats().waiting != 1 {
+                tokio::task::yield_now().await;
+            }
+        })
+        .await
+        .unwrap();
+        admission.set_limit(2);
+        let second = tokio::time::timeout(Duration::from_secs(1), waiter)
+            .await
+            .unwrap()
+            .unwrap();
+        assert_eq!(admission.stats().active, 2);
+        drop(first);
+        drop(second);
+    }
+
+    #[tokio::test]
+    async fn test_creation_admission_cancelled_waiter_is_not_leaked() {
+        let admission = Arc::new(CreatingStreamingJobPermit::with_limit(1));
+        let _first = admission.acquire_job(JobId::new(40)).await;
+        let waiting_admission = admission.clone();
+        let waiter =
+            tokio::spawn(async move { waiting_admission.acquire_job(JobId::new(41)).await });
+        tokio::time::timeout(Duration::from_secs(1), async {
+            while admission.stats().waiting != 1 {
+                tokio::task::yield_now().await;
+            }
+        })
+        .await
+        .unwrap();
+        waiter.abort();
+        assert!(waiter.await.unwrap_err().is_cancelled());
+        assert_eq!(admission.stats().waiting, 0);
+        assert_eq!(admission.stats().active, 1);
+    }
+
+    #[test]
+    fn test_creation_admission_anonymous_and_job_share_capacity() {
+        let admission = Arc::new(CreatingStreamingJobPermit::with_limit(1));
+        let anonymous = admission.try_acquire_inner(None).unwrap();
+        assert!(admission.try_acquire_job(JobId::new(50)).is_none());
+        assert_eq!(admission.stats().tracked_jobs, 0);
+        drop(anonymous);
+        let job = admission.try_acquire_job(JobId::new(50)).unwrap();
+        assert_eq!(admission.stats().tracked_jobs, 1);
+        drop(job);
+    }
+
+    #[test]
+    fn test_creation_admission_zero_limit_means_unlimited() {
+        let admission = Arc::new(CreatingStreamingJobPermit::with_limit(0));
+        let mut permits = Vec::new();
+        for id in 100..228 {
+            permits.push(admission.try_acquire_job(JobId::new(id)).unwrap());
+        }
+        assert_eq!(admission.stats().active, 128);
+        drop(permits);
+        assert_eq!(admission.stats().active, 0);
+    }
